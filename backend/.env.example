# ===== CONFIGURAÇÃO DO SERVIDOR =====
PORT=3000
NODE_ENV=development

# ===== CONFIGURAÇÃO DE EMAIL (obrigatório para recuperação de password por email) =====
# Gmail: https://myaccount.google.com/apppasswords
# 1) Ative verificação em 2 passos
# 2) Crie uma «Palavra-passe de aplicação»
# 3) Use essa palavra-passe em EMAIL_PASS (não a password normal do Gmail)
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_USER=seu@gmail.com
EMAIL_PASS=xxxx xxxx xxxx xxxx
EMAIL_FROM=Sense Barbershop <seu@gmail.com>

# Email que recebe aviso de cada nova marcação (cliente marca → notificação)
NOTIFY_BOOKING_EMAIL=sensebarber10@gmail.com

# ===== CONFIGURAÇÃO DO BANCO DE DADOS =====
# Local (desenvolvimento):
# DATABASE_PATH=./database/barbearia_sense.db
# UPLOADS_PATH=./uploads

# Produção no Render Free (RECOMENDADO): Turso — SQLite na cloud (grátis)
# 1) https://turso.tech → criar base "sense-barber"
# 2) Copiar URL e token para o Environment do Render
TURSO_DATABASE_URL=libsql://sense-barber-xxxx.turso.io
TURSO_AUTH_TOKEN=eyJ...

# Fotos permanentes (galeria / serviços) — Cloudinary (grátis)
# 1) https://cloudinary.com → registo → Dashboard
# 2) Copiar "API environment variable" (CLOUDINARY_URL)
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME

# Alternativa no Render Starter+: disco local
# DATABASE_PATH=/var/data/barbearia_sense.db
# UPLOADS_PATH=/var/data/uploads
# DATA_DIR=/var/data

# ===== CONFIGURAÇÃO CORS =====
# Liste os domínios permitidos
CORS_ORIGIN=http://localhost:5500,http://localhost:3000,http://localhost:8000

# ===== AUTENTICAÇÃO =====
JWT_SECRET=altere-esta-chave-secreta-em-producao
FRONTEND_URL=http://localhost:3000

# Gmail (recomendado): EMAIL_HOST=smtp.gmail.com, EMAIL_USER=seu@gmail.com
# Crie uma palavra-passe de app em: https://myaccount.google.com/apppasswords

# ===== GOOGLE SIGN-IN =====
# Crie um projeto NOVO em: https://console.cloud.google.com/
# Nome da app OAuth: "Sense Barbershop" (NÃO use credenciais de outro site como Poki)
# Tipo: ID do cliente OAuth → Aplicação Web
# Origens autorizadas: http://localhost:3000
GOOGLE_CLIENT_ID=seu-client-id.apps.googleusercontent.com

# Email(s) do administrador principal (separados por vírgula)
ADMIN_EMAILS=sensebarber10@gmail.com
